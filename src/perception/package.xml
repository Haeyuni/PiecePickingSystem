<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception</name>
  <version>0.0.1</version>
  <description>RGB-D 손목 카메라 기반 물체 검출·세그멘테이션, /perception/world_state_raw 및 /perception/instance_masks 발행</description>
  <maintainer email="jje320594@gmail.com">jje</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_copyright</buildtool_depend>
  <buildtool_depend>ament_flake8</buildtool_depend>
  <buildtool_depend>ament_pep257</buildtool_depend>
  <buildtool_depend>python3-pytest</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sort_msgs</depend>
  <depend>std_msgs</depend>
  <!-- 현재 TCP 자세(get_current_posx 서비스). eye-in-hand 변환에 필요하다 —
       robot_pose.py 주석 참조. DSR_ROBOT2 API가 아니라 서비스만 쓴다. -->
  <depend>dsr_msgs2</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
