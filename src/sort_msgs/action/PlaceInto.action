# --- Goal ---
string schema_version
string trace_id
string request_id
string source_observation_id
string object_id
string bin_id                    # bins.yaml에 등록된 목적지 중 하나. LLM은 이 중에서만 선택 가능 (그라운딩)
bool use_pose_override
geometry_msgs/Pose pose_override  # use_pose_override=false면 무시. 1차 범위에서는 사용하지 않으며,
                                   # 확장 단계(정렬 배치 등)에서 bin_pose 기준 정밀 자세 조정이 필요할 때 사용
# 잡고 있는 물체가 TCP보다 얼마나 아래로 내려와 있는지(mm) = 파지 z - 물체 지지면 z.
# web/orchestrator가 DetectedObject.height_mm과 고른 파지 후보의 z로 계산해 넣는다.
# place_server는 놓는 z를 bin_pose.z + 이 값 + release_clearance_mm로 잡는다 — 즉
# release_clearance_mm이 "물체 높이 짐작"이 아니라 순수한 안전 여유가 된다.
# 0이면 미상 — place_server가 예전처럼 release_clearance_mm만 쓴다(하위호환).
float32 object_bottom_offset_mm

# 3차 frozen PickSnapshot. box geometry가 실측된 경우에만 아래 값으로 geometry mode를 쓴다.
# pickup_tcp_posx는 실제 pick closure TCP [x,y,z,rx,ry,rz](mm/ZYZ deg)이고,
# tcp_to_object_bottom_mm은 그 TCP에서 pick 당시 물체 support까지의 base-Z 거리다.
bool has_pick_snapshot
float64[6] pickup_tcp_posx
float32 tcp_to_object_bottom_mm
geometry_msgs/Polygon object_footprint_base_mm
int32 max_retries
---
# --- Result ---
bool success

string REASON_NONE=none
string REASON_NO_CONTACT=no_contact
string REASON_PLACE_FAILED=place_failed
string REASON_UNREACHABLE=unreachable
string REASON_COLLISION_EXPECTED=collision_expected
# 안전 이송 높이(safe_z)에서 바구니 상공까지 갈 방법을 못 찾았다 — 어떤 solution space,
# 어떤 경로로도 안 된다는 뜻이다(2026-09-10, STEP 2).
#
# **이 경우 높이를 낮춰 억지로 성공시키지 않는다.** 예전에는 IK가 안 풀리면 안전고도를
# 20mm씩 낮춰 재시도했는데, 그 높이는 이동 중 물체가 작업대·바구니 테두리를 넘어가라고
# 둔 값이라 IK 사정으로 깎으면 그 높이를 둔 이유 자체가 사라진다. 도달 못 하면 그대로
# 실패로 보고하고, 사람이 배치를 바꾸거나 목적지를 조정하게 한다.
string REASON_SAFE_TRANSIT_UNREACHABLE=safe_transit_unreachable
string failure_reason

int32 retries_used
float32 cycle_time_ms
---
# --- Feedback ---
string PHASE_MOVING=moving
string PHASE_INSERTING=inserting
string PHASE_RELEASING=releasing
string PHASE_VERIFYING=verifying
string phase
