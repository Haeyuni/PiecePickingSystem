# .env 템플릿. 이 파일만 git으로 관리하고, 실제 값이 든 .env는 커밋하지 않는다.
# 사용법: cp .env.example .env 후 값을 채운다.

# --- LLM/VLM (개발계획.md D-3) ---
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-proj-...

# --- DB (시스템명세서 2절) ---
POSTGRES_DB=piece_picking
POSTGRES_USER=piece_picking
POSTGRES_PASSWORD=          # 로컬에서 임의 생성: openssl rand -base64 24

# --- 캘리브레이션 결과 (개발계획.md D-2) ---
# 컨테이너 내부 경로. 호스트의 data/calibration/을 볼륨 마운트한 위치를 가리킨다.
HANDEYE_PATH=/data/calibration/T_gripper2camera.npy

# --- 개발 모드 ---
# 1이면 web이 ROS2 대신 data/mock 픽스처로 동작한다 (개발계획.md 4.2절 B2)
# 0으로 쓰는 것은 web이 아니라 web_ros 서비스다: docker compose --profile ros up web_ros
MOCK_MODE=1

# --- ROS2 (개발계획.md 4.2절 B4) ---
# web_ros가 호스트의 control/perception 노드와 통신하기 위한 값. 호스트 셸에서
# `echo $ROS_DOMAIN_ID`로 확인한 값과 같아야 서로 보인다.
ROS_DOMAIN_ID=0

# 호스트의 CycloneDDS 설정 디렉터리. web_ros에 읽기 전용으로 마운트한다.
# RMW가 다르거나 인터페이스 선택이 다르면 토픽 목록은 보이는데 데이터가 흐르지 않는다.
# **절대경로로 쓴다** — compose는 변수는 치환해도 ~ 는 펼치지 않는다.
# 미설정 시 $HOME/.config/cyclonedds를 쓴다.
#CYCLONEDDS_CONFIG_DIR=/home/사용자/.config/cyclonedds

# doosan-robot2 드라이버 워크스페이스(dsr_msgs2 등). grasp/perception 컨테이너가
# get_current_posx 서비스 타입을 이미지에 굽지 않고 여기서 마운트해 쓴다(src/grasp/
# docker-entrypoint.sh 참조). 미설정 시 $HOME/cobot2_ws를 쓴다. **절대경로로 쓴다.**
#DOOSAN_WS_DIR=/home/사용자/cobot2_ws

# 모델 ID. 미설정 시 planner의 기본값(gpt-4o) 사용
OPENAI_MODEL=gpt-4o
