# .env 템플릿. 이 파일만 git으로 관리하고, 실제 값이 든 .env는 커밋하지 않는다.
# 사용법: cp .env.example .env 후 값을 채운다.

# --- LLM/VLM (개발계획.md D-3) ---
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-proj-...

# --- DB (시스템명세서 2절) ---
POSTGRES_DB=piece_picking
POSTGRES_USER=piece_picking
POSTGRES_PASSWORD=          # 로컬에서 임의 생성: openssl rand -base64 24

# --- 캘리브레이션 결과 (개발계획.md D-2) ---
# 컨테이너 내부 경로. 호스트의 data/calibration/을 볼륨 마운트한 위치를 가리킨다.
HANDEYE_PATH=/data/calibration/T_gripper2camera.npy

# --- 개발 모드 ---
# 1이면 web이 ROS2 대신 data/mock 픽스처로 동작한다 (개발계획.md 4.2절 B2)
MOCK_MODE=1

# 모델 ID. 미설정 시 planner의 기본값(gpt-4o) 사용
OPENAI_MODEL=gpt-4o
